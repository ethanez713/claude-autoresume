#!/usr/bin/env bash
# claude-autoresume attach — reattach to the private `ccar` fallback session, or,
# when its tmux server is gone (reboot, `wsl --shutdown`, a killed server),
# reopen the Claude tabs that were open last session. `claude` itself now does
# this on launch, so this stays as the explicit "just reattach/reopen" entry
# point. The candidate directories, the pick-list, and the rebuild all live in
# ccar-lib.sh, shared with cc-run.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
config="${CCAR_CONFIG:-$here/config.sh}"
if [ ! -f "$config" ]; then
  echo "Missing config: cp '$here/config.example.sh' '$here/config.sh' and review it." >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$config"
# shellcheck source=/dev/null
source "$here/bin/ccar-lib.sh"

tx() { tmux -L "$CCAR_TMUX_SOCKET" "$@"; }

# Attach the way cc-run does: TERM is overridden for the OUTER attach so the TUI
# renders with xterm caps instead of the shell's screen-256color (see config.sh).
attach_session() {
  local attach_env=()
  [ -n "${CCAR_OUTER_TERM:-}" ] && attach_env+=(TERM="$CCAR_OUTER_TERM")
  exec env "${attach_env[@]}" tmux -L "$CCAR_TMUX_SOCKET" attach -t "$CCAR_TMUX_SESSION"
}

# The non-interactive preview: one line per directory and whether it will
# continue a conversation or start fresh. The interactive path shows the same
# facts through the pick-list instead.
preview_list() { # $@ = dirs
  local dir n
  for dir in "$@"; do
    n="$(transcript_count "$dir")"
    if [ "$n" -gt 0 ]; then
      printf '  %s  (claude -c — continues the last of %s)\n' "$dir" "$n"
    else
      printf '  %s  (claude — no saved conversation, starts fresh)\n' "$dir"
    fi
  done
}

usage() {
  cat <<EOF
Usage: cc-attach [-y]

Attaches to the '$CCAR_TMUX_SESSION' session on the private '$CCAR_TMUX_SOCKET'
socket. If that server is gone, reopens the Claude tabs that were open last
session (across every tmux server, not just this one), letting you pick which in
an arrow-key list first.

  -y, --yes   reopen them all without asking
EOF
}

main() {
  local arg assume_yes=0
  for arg in "$@"; do
    case "$arg" in
      -y|--yes)  assume_yes=1 ;;
      -h|--help) usage; return 0 ;;
      *) echo "cc-attach: unknown option '$arg' (see --help)" >&2; return 2 ;;
    esac
  done

  if [ -n "${TMUX:-}" ]; then
    echo "cc-attach: already inside tmux — attaching here would nest a server." >&2
    echo "Detach first (your prefix, then d), or run this from a plain shell." >&2
    return 1
  fi

  if tx has-session -t "$CCAR_TMUX_SESSION" 2>/dev/null; then
    attach_session
  fi

  local cands=()
  mapfile -t cands < <(reconstruct_candidates)
  if [ "${#cands[@]}" -eq 0 ]; then
    echo "No server on socket '$CCAR_TMUX_SOCKET', and the registry names no"
    echo "directory to reopen ($CCAR_PANES_DIR)."
    echo "Start one with: cd <project> && claude"
    return 1
  fi

  echo "No tmux server on socket '$CCAR_TMUX_SOCKET' — session '$CCAR_TMUX_SESSION' is gone."
  echo "Scrollback and any unsent input from the old session are not recoverable."
  echo

  local chosen=()
  if [ "$assume_yes" -eq 1 ]; then
    echo "Reopening ${#cands[@]} window(s):"
    preview_list "${cands[@]}"
    chosen=("${cands[@]}")
  elif [ ! -t 0 ]; then
    echo "Would reopen ${#cands[@]} window(s):"
    preview_list "${cands[@]}"
    echo
    echo "cc-attach: not a terminal — re-run with -y to reopen them without picking." >&2
    return 1
  else
    mapfile -t chosen < <(printf '%s\n' "${cands[@]}" | tui_multiselect) \
      || { echo "Cancelled — nothing was started."; return 1; }
    if [ "${#chosen[@]}" -eq 0 ]; then
      echo "Nothing selected — nothing was started."; return 1
    fi
  fi

  rebuild_session "" "${chosen[@]}"
  attach_session
}

# When sourced (tests), expose the functions but don't run.
if [ "${BASH_SOURCE[0]}" != "$0" ]; then
  return 0
fi

main "$@"
